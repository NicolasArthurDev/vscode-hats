{
  "name": "hats-profile-switcher",
  "displayName": "Hats",
  "description": "Wear the right hat for each project. Switch profiles and tint the window per workspace.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other",
    "Themes"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hats-profile-switcher.openMenu",
        "title": "Hats: Open Menu",
        "category": "Hats"
      },
      {
        "command": "hats-profile-switcher.switchProfile",
        "title": "Hats: Switch Profile",
        "category": "Hats"
      },
      {
        "command": "hats-profile-switcher.newProfileFromTemplate",
        "title": "Hats: New Profile from Template",
        "category": "Hats"
      },
      {
        "command": "hats-profile-switcher.setColor",
        "title": "Hats: Set Window Color",
        "category": "Hats"
      },
      {
        "command": "hats-profile-switcher.clearColor",
        "title": "Hats: Clear Window Color",
        "category": "Hats"
      }
    ],
    "configuration": {
      "title": "Hats",
      "properties": {
        "hats.color": {
          "type": "string",
          "default": "",
          "description": "The window accent color currently applied by Hats (managed by the extension; usually set through the Hats menu)."
        },
        "hats.elements": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "titleBar": {
              "type": "boolean",
              "description": "Tint the title bar."
            },
            "activityBar": {
              "type": "boolean",
              "description": "Tint the activity bar."
            },
            "statusBar": {
              "type": "boolean",
              "description": "Tint the status bar."
            }
          },
          "default": {
            "titleBar": true,
            "activityBar": true,
            "statusBar": true
          },
          "description": "Which workbench elements the hat color is applied to."
        },
        "hats.palette": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "color"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Display name of the hat."
              },
              "color": {
                "type": "string",
                "pattern": "^#([0-9a-fA-F]{6})$",
                "description": "Accent color as a #rrggbb hex string."
              }
            }
          },
          "default": [],
          "description": "Named hats to offer in the color picker. When empty, a built-in palette is used."
        },
        "hats.statusBar.alignment": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "default": "right",
          "description": "Side of the status bar where the Hats button is shown."
        },
        "hats.statusBar.showWorkspaceName": {
          "type": "boolean",
          "default": true,
          "description": "Show the current workspace name on the Hats button."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
